{
  "schema_version": 1,
  "backend_id": "llama.cpp",
  "display_name": "llama.cpp",
  "adapter_api_version": "1.0",
  "upstream_project": "ggml-org/llama.cpp",
  "module": "rift.backends.llama_cpp.backend",
  "tuning_module": "rift.backends.llama_cpp.tuning",
  "supported_tasks": ["chat", "completion", "embeddings", "reranking", "vision-language"],
  "supported_formats": ["gguf"],
  "quantizations": ["q2", "q3", "q4", "q5", "q6", "q8", "iq", "f16", "bf16"],
  "operating_systems": ["windows", "linux", "macos"],
  "accelerators": ["cpu", "cuda", "metal", "vulkan"],
  "installation_methods": ["release-archive", "native", "container"],
  "endpoints": ["openai", "embeddings", "reranking"],
  "features": ["continuous-batching", "grammar-constrained-output", "speculative-decoding", "cpu-offload", "tensor-split", "multimodal-with-mmproj", "tool-calling-probe"],
  "tuning_profiles": ["speed", "cost"],
  "tuning_parameters": [
    {"name": "gpu_layers", "type": "integer", "group": "placement", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "batch", "type": "integer", "group": "batching", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "ubatch", "type": "integer", "group": "batching", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "threads", "type": "integer", "group": "cpu", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "threads_batch", "type": "integer", "group": "cpu", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "flash_attn", "type": "string", "group": "execution", "profiles": ["speed"], "restart_required": true},
    {"name": "cache_type_k", "type": "string", "group": "kv_precision", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "cache_type_v", "type": "string", "group": "kv_precision", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "kv_offload", "type": "boolean", "group": "offload", "profiles": ["speed", "cost"], "restart_required": true},
    {"name": "continuous_batching", "type": "boolean", "group": "batching", "profiles": ["speed"], "restart_required": true}
  ],
  "topology_modes": ["single_node", "replicated", "tensor_split"],
  "evidence_status": "verified_local",
  "multi_gpu": true,
  "streaming": true,
  "description": "Portable GGUF inference backend operated as an external llama-server process."
}
